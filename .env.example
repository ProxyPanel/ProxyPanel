APP_NAME=ProxyPanel
APP_ENV=production
APP_KEY=
APP_DEBUG=
APP_URL=https://proxypanel.ddo.jp
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 数据库
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ProxyPanel
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_CONNECTION=session
# 客户端 API token 的有效期，单位分钟；留空或 0 = 不签发过期 token（历史行为）。
# 开启后只作用于新签发的 token，部署前发出去的老 token 不会被作废；
# 需要长会话的客户端把它调大，或直接按登录响应里的 expire_in 重新登录。
# SANCTUM_TOKEN_EXPIRATION=1440

# Redis 设置
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# SMTP设置
MAIL_HOST=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_USERNAME=admin@proxypanel.demo
MAIL_PASSWORD=password
MAIL_ENCRYPTION=ssl
# 发信方信息
MAIL_FROM_ADDRESS=admin@proxypanel.demo
MAIL_FROM_NAME=ProxyPanel
# 会话 Cookie 只允许走 HTTPS；不写这一行即默认 true，HTTP 站点显式设为 false
# 注意写空值等于 false，不会回落到默认
# SESSION_SECURE_COOKIE=

#IP查询相关
BAIDU_APP_AK=
IPINFO_ACCESS_TOKEN=
IP2LOCATION_API_KEY=
IP_API_ACCESS_KEY=
IP_API_KEY=ipapiq9SFY1Ic4
IPDATA_API_KEY=
BJJII_KEY=

API_LAYER_API_KEY=
CONTACT_TELEGRAM=https://t.me/+nW8AwsPPUsliYzg1

# 自建探针服务器配置 Self Host Probe Servers
PROBE_SERVERS_DOMESTIC=
PROBE_SERVERS_FOREIGN=

# Reverb WebSocket 配置
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SCHEME=http
REVERB_HOST=
# 子路径部署的唯一来源（单一来源）：留空表示 Reverb 直接挂在独立端口或子域上（推荐）。
# 需要挂子路径时只写规范形式——前导 / 且结尾不带 /，例如 REVERB_PATH=/casting，
# 并让 nginx 原样转发该前缀；改完执行 php artisan optimize，再跑 php artisan reverb:check 验证。
# 下面的派生值 VITE_REVERB_PATH / REVERB_SERVER_PATH 都由它插值而来，不要单独编辑。
REVERB_PATH=
# 可选，REVERB后端默认为8080
REVERB_SERVER_PORT=
# 可选，REVERB前端 默认为443/80 取决于 REVERB_SCHEME
REVERB_PORT=

# 以下均为派生值（由上面的 REVERB_ 变量插值而来），保持原样即可
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_PATH="${REVERB_PATH}"
REVERB_SERVER_PATH="${REVERB_PATH}"
